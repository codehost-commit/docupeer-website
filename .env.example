# Local development environment. Copy to `.env` and change AUTH_SECRET.

# SQLite database (file-based, zero-config). Swap for a Postgres URL to move to production.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. MUST be changed for any real deployment.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-16-chars"

# AI-content detection threshold. A review is blocked when its estimated
# AI-generated fraction exceeds this value (0.10 = 10%).
AI_CONTENT_THRESHOLD="0.10"

# Which AI-detection provider to use. `heuristic` ships by default.
# See src/lib/ai-detection/ for the interface used to plug in a real provider.
AI_DETECTOR_PROVIDER="heuristic"

# Groq API key powering Secretariat.
# Main model: openai/gpt-oss-120b · helper model: openai/gpt-oss-20b
# Get one at https://console.groq.com/keys
GROQ_API_KEY=""

# Groq API key powering Atom for DocuPeer.
# Model: openai/gpt-oss-120b
GROQ_ATOM_API_KEY=""
