# Local development environment. Copy to `.env` and change AUTH_SECRET.

# SQLite database (file-based, zero-config). Swap for a Postgres URL to move to production.
DATABASE_URL="file:./dev.db"

# Secret used to sign session JWTs. MUST be changed for any real deployment.
# Generate one with: openssl rand -hex 32
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-16-chars"

# AI-content detection threshold. A review is blocked when its estimated
# AI-generated fraction exceeds this value (0.10 = 10%).
AI_CONTENT_THRESHOLD="0.10"

# Which AI-detection provider to use. `heuristic` ships by default.
# See src/lib/ai-detection/ for the interface used to plug in a real provider.
AI_DETECTOR_PROVIDER="heuristic"

# Groq API key powering Secretariat.
# Main model: openai/gpt-oss-120b · helper model: openai/gpt-oss-20b
# Get one at https://console.groq.com/keys
GROQ_API_KEY=""

# Groq API key powering Atom for DocuPeer.
# Model: openai/gpt-oss-120b
GROQ_ATOM_API_KEY=""

# ============================================================
# Atom — student planner (atom.docupeer.org)
# ============================================================

# Grade-import + label AI already uses GROQ_ATOM_API_KEY above.

# Web Push (VAPID). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
ATOM_VAPID_PUBLIC_KEY=""
ATOM_VAPID_PRIVATE_KEY=""
ATOM_VAPID_SUBJECT="mailto:hello@docupeer.org"

# Email reminders via Resend (https://resend.com). Verify your sending domain.
RESEND_API_KEY=""
ATOM_EMAIL_FROM="Atom by DocuPeer <atom@docupeer.org>"

# Protects the reminder cron endpoint. Vercel Cron sends it as `Authorization: Bearer`.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# Public URL used in notification deep links.
ATOM_PUBLIC_URL="https://atom.docupeer.org"

# Cron sweep window in minutes — match your cron interval (75 suits an hourly cron).
ATOM_CRON_WINDOW_MINUTES="75"
